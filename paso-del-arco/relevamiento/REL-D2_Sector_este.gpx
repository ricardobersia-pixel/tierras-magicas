<metadata><name>REL-D2 Sector este: Vaquero y Arroyo del Arco</name><desc>Documentar la Base 2, el cruce de la RP12 hacia el este y la costa del Arroyo del Arco (límite este).</desc></metadata>
<wpt lat="-38.832050" lon="-71.066724"><name>01 O-BAS-01 Base 1 — Inicio (quincho)</name><desc>Exterior, interior, cocina, baño, agua, energía, señal celular</desc><sym>Flag</sym></wpt>
<wpt lat="-38.810607" lon="-71.057450"><name>02 R-ACC-02 Cruce N (RP12 / camino desde el este)</name><desc>Foto del cruce; señalización; visibilidad</desc><sym>Flag</sym></wpt>
<wpt lat="-38.814204" lon="-71.050709"><name>03 E-BAS-02 Base 2 — Vaquero</name><desc>Infraestructura, fogón, agua, sombra; por dónde se cruza la RP12</desc><sym>Flag</sym></wpt>
<wpt lat="-38.811902" lon="-71.032685"><name>04 E-PTE-01 Puente sobre el río (¿Arroyo del Arco?)</name><desc>Nombre del curso; estructura y carga del puente</desc><sym>Flag</sym></wpt>
<wpt lat="-38.814332" lon="-71.030565"><name>05 E-VAD-01 Vado del río</name><desc>Lecho, profundidad del día, marcas de crecida</desc><sym>Flag</sym></wpt>
<wpt lat="-38.825382" lon="-71.022712"><name>06 E-AGU-01 Vertiente</name><desc>Caudal; ¿dentro del campo?</desc><sym>Flag</sym></wpt>
