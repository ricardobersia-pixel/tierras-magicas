<wpt lat="-38.802437" lon="-71.058298"><name>07 O-MIR-01 Cima</name><desc>Panorámica 360°; acceso</desc><sym>Flag</sym></wpt>
<wpt lat="-38.805388" lon="-71.058735"><name>08 O-TRQ-02 Entrada campo mecánico</name><desc>¿Tranquera desde la RP12? Lado de la ruta</desc><sym>Flag</sym></wpt>
