<metadata><name>REL-D1 Acceso, RP12 y sector oeste núcleo</name><desc>Documentar la llegada del cliente y las bases 1 y 3; grabar el camino a Chivero.</desc></metadata>
<wpt lat="-38.902440" lon="-71.064667"><name>01 R-ACC-01 Acceso RP13/RP12 (Paso del Arco)</name><desc>Foto de la intersección, cartelería y estado de la calzada</desc><sym>Flag</sym></wpt>
<wpt lat="-38.896102" lon="-71.056230"><name>02 R-MIR-01 Vista del Aluminé</name><desc>Panorámica; lugar para detenerse fuera de la calzada</desc><sym>Flag</sym></wpt>
<wpt lat="-38.832922" lon="-71.058162"><name>03 O-TRQ-01 Tranquera 1</name><desc>Tipo de cierre, ancho, visibilidad al salir a la RP12</desc><sym>Flag</sym></wpt>
