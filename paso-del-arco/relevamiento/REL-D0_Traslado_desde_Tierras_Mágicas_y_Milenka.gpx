<metadata><name>REL-D0 Traslado desde Tierras Mágicas y Milenka</name><desc>Medir tiempos reales del traslado complejo → acceso → Tranquera 1 → Inicio y regreso, por estación (bloque R0).</desc></metadata>
<wpt lat="-38.901100" lon="-71.290900"><name>01 AMO-ALO-01 Tierras Mágicas (complejo de origen, Moquehue)</name><desc>Punto de salida: hora de partida, estacionamiento, carga de equipos</desc><sym>Flag</sym></wpt>
<wpt lat="-38.900986" lon="-71.291336"><name>02 AMO-ALO-02 Milenka (complejo contiguo a Tierras Mágicas)</name><desc>Entrada; punto de encuentro común con TM (≈40 m)</desc><sym>Flag</sym></wpt>
<wpt lat="-38.902440" lon="-71.064667"><name>03 R-ACC-01 Acceso RP13/RP12 (Paso del Arco)</name><desc>Foto de la intersección, cartelería y estado de la calzada</desc><sym>Flag</sym></wpt>
<wpt lat="-38.896102" lon="-71.056230"><name>04 R-MIR-01 Vista del Aluminé</name><desc>Panorámica; lugar para detenerse fuera de la calzada</desc><sym>Flag</sym></wpt>
<wpt lat="-38.832922" lon="-71.058162"><name>05 O-TRQ-01 Tranquera 1</name><desc>Tipo de cierre, ancho, visibilidad al salir a la RP12</desc><sym>Flag</sym></wpt>
<wpt lat="-38.832050" lon="-71.066724"><name>06 O-BAS-01 Base 1 — Inicio (quincho)</name><desc>Exterior, interior, cocina, baño, agua, energía, señal celular</desc><sym>Flag</sym></wpt>
