<wpt lat="-38.902440" lon="-71.064667"><name>02 R-ACC-01 Acceso RP13/RP12 (Paso del Arco)</name><desc>Foto de la intersección, cartelería y estado de la calzada</desc><sym>Flag</sym></wpt>
<wpt lat="-38.896102" lon="-71.056230"><name>03 R-MIR-01 Vista del Aluminé</name><desc>Panorámica; lugar para detenerse fuera de la calzada</desc><sym>Flag</sym></wpt>
<wpt lat="-38.832922" lon="-71.058162"><name>04 O-TRQ-01 Tranquera 1</name><desc>Tipo de cierre, ancho, visibilidad al salir a la RP12</desc><sym>Flag</sym></wpt>
<wpt lat="-38.832050" lon="-71.066724"><name>05 O-BAS-01 Base 1 — Inicio (quincho)</name><desc>Exterior, interior, cocina, baño, agua, energía, señal celular</desc><sym>Flag</sym></wpt>
