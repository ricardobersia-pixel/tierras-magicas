<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Paso del Arco - relevamiento POI v1" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>PDA POI base v1</name><desc>Puntos conocidos para verificar en el relevamiento con fotos. No representa límites ni accesos autorizados.</desc></metadata>
<wpt lat="-38.902440" lon="-71.064667"><name>PDA-POI-001 Acceso RP13/RP12 (Paso del Arco)</name><desc>Tipo: Acceso. Origen: CONF titular. Estado: Coordenada confirmada. Relevar: Foto de la intersección y señalización; estado del camino</desc><type>Acceso</type></wpt>
<wpt lat="-38.832922" lon="-71.058162"><name>PDA-POI-002 Tranquera 1 (RP12)</name><desc>Tipo: Tranquera. Origen: CONF titular. Estado: Coordenada confirmada. Relevar: Foto, tipo de cierre, ancho, visibilidad desde la RP12</desc><type>Tranquera</type></wpt>
<wpt lat="-38.832050" lon="-71.066724"><name>PDA-POI-003 Base 1 — Inicio (quincho)</name><desc>Tipo: Base. Origen: CONF titular. Estado: Coordenada confirmada. Relevar: Fotos exteriores/interiores, cocina, baño, agua, energía, señal</desc><type>Base</type></wpt>
<wpt lat="-38.814204" lon="-71.050709"><name>PDA-POI-004 Base 2 — Vaquero</name><desc>Tipo: Base. Origen: CONF titular. Estado: Coordenada confirmada. Relevar: Fotos, infraestructura existente, fogón, agua, sombra</desc><type>Base</type></wpt>
<wpt lat="-38.807993" lon="-71.063218"><name>PDA-POI-005 Base 3 — Chivero</name><desc>Tipo: Base. Origen: CONF titular. Estado: Coordenada confirmada; camino sin traza. Relevar: Grabar el camino desde la RP12; fotos, corrales, espacios para chicos</desc><type>Base</type></wpt>
<wpt lat="-38.791826" lon="-71.058897"><name>PDA-POI-006 Aduana Vieja (Paso del Arco)</name><desc>Tipo: Patrimonio. Origen: EXT wpt 003 (012 lo ubica a 85 m). Estado: Verificar. Relevar: Fotos, estado de ruinas, ¿dentro del campo?</desc><type>Patrimonio</type></wpt>
<wpt lat="-38.790233" lon="-71.059082"><name>PDA-POI-007 Vado Aduana Vieja</name><desc>Tipo: Vado. Origen: EXT wpt 012. Estado: Verificar. Relevar: Fondo, profundidad típica, crecidas</desc><type>Vado</type></wpt>
<wpt lat="-38.792104" lon="-71.070767"><name>PDA-POI-008 Castillo / Grupo el Arco</name><desc>Tipo: Formación. Origen: EXT wpt 003 = 024. Estado: Verificar. Relevar: Fotos; ¿es el 'arco' que da nombre al paso?</desc><type>Formación</type></wpt>
<wpt lat="-38.802437" lon="-71.058298"><name>PDA-POI-009 Cima</name><desc>Tipo: Mirador. Origen: EXT wpt 003. Estado: Verificar. Relevar: Foto panorámica 360°, acceso</desc><type>Mirador</type></wpt>
<wpt lat="-38.806765" lon="-71.061762"><name>PDA-POI-010 CP (significado a re-identificar)</name><desc>Tipo: Otro. Origen: EXT wpt 003. Estado: Re-identificar. Relevar: Foto y descripción</desc><type>Otro</type></wpt>
<wpt lat="-38.805388" lon="-71.058735"><name>PDA-POI-011 Entrada campo mecánico</name><desc>Tipo: Tranquera/acceso. Origen: EXT wpt 024. Estado: Verificar. Relevar: ¿Es otra tranquera desde la RP12?</desc><type>Tranquera/acceso</type></wpt>
<wpt lat="-38.818238" lon="-71.103710"><name>PDA-POI-012 Punto límite campo (¿Cerro Piñihue?)</name><desc>Tipo: Límite. Origen: EXT wpt 003. Estado: Verificar. Relevar: ¿Coincide con el Cerro Piñihue o con un alambrado?</desc><type>Límite</type></wpt>
<wpt lat="-38.836408" lon="-71.097463"><name>PDA-POI-013 Laguna Pilhue</name><desc>Tipo: Laguna. Origen: EXT wpt 012. Estado: Verificar. Relevar: Fotos, acceso, ¿dentro del campo?</desc><type>Laguna</type></wpt>
<wpt lat="-38.836738" lon="-71.096347"><name>PDA-POI-014 Entrada Pilhue</name><desc>Tipo: Acceso. Origen: EXT wpt 010. Estado: Verificar. Relevar: Tipo de acceso</desc><type>Acceso</type></wpt>
<wpt lat="-38.826952" lon="-71.124900"><name>PDA-POI-015 Laguna Corazón</name><desc>Tipo: Laguna. Origen: EXT wpt 012. Estado: Verificar. Relevar: Fotos, acceso, titularidad</desc><type>Laguna</type></wpt>
<wpt lat="-38.804152" lon="-71.171810"><name>PDA-POI-016 Laguna del Arco</name><desc>Tipo: Laguna. Origen: EXT wpt 012. Estado: Verificar. Relevar: Fotos, acceso, titularidad</desc><type>Laguna</type></wpt>
<wpt lat="-38.803313" lon="-71.169027"><name>PDA-POI-017 Vado Laguna del Arco</name><desc>Tipo: Vado. Origen: EXT wpt 012. Estado: Verificar. Relevar: Fondo y profundidad</desc><type>Vado</type></wpt>
<wpt lat="-38.817470" lon="-71.164700"><name>PDA-POI-018 Laguna Escondida</name><desc>Tipo: Laguna. Origen: EXT wpt 012. Estado: Verificar. Relevar: Fotos</desc><type>Laguna</type></wpt>
<wpt lat="-38.824605" lon="-71.153913"><name>PDA-POI-019 Araucaria Guacha</name><desc>Tipo: Árbol singular. Origen: EXT wpt 012. Estado: Verificar. Relevar: Fotos</desc><type>Árbol singular</type></wpt>
<wpt lat="-38.811902" lon="-71.032685"><name>PDA-POI-020 Río / Puente / Vado (¿Arroyo del Arco?)</name><desc>Tipo: Vado/Puente. Origen: EXT wpt 013 (Puente). Estado: Verificar. Relevar: Nombre del curso de agua; carga del puente; ¿costa límite del campo?</desc><type>Vado/Puente</type></wpt>
<wpt lat="-38.784122" lon="-71.092310"><name>PDA-POI-021 Vado (024)</name><desc>Tipo: Vado. Origen: EXT wpt 024. Estado: Verificar. Relevar: Fondo y profundidad</desc><type>Vado</type></wpt>
<wpt lat="-38.825382" lon="-71.022712"><name>PDA-POI-022 Vertiente</name><desc>Tipo: Agua. Origen: EXT wpt 013. Estado: Verificar. Relevar: Caudal; ¿potable? (análisis)</desc><type>Agua</type></wpt>
<wpt lat="-38.896102" lon="-71.056230"><name>PDA-POI-023 Vista del Aluminé</name><desc>Tipo: Mirador. Origen: EXT wpt 012. Estado: Verificar. Relevar: Foto panorámica (1 km del acceso)</desc><type>Mirador</type></wpt>
<wpt lat="-38.815728" lon="-71.185668"><name>PDA-POI-024 Batea Mahuida — punto más alto registrado (020)</name><desc>Tipo: Cerro. Origen: INF: punto de mayor altitud de la traza 020; NO es la cumbre. Estado: Referencia. Relevar: Solo con autorización de la Comunidad Puel</desc><type>Cerro</type></wpt>
</gpx>