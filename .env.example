# Copiar a .env y completar. Nunca subir .env a GitHub.
PORT=3000
# URL pública del sitio (necesaria para Mercado Pago y para los enlaces iCal)
BASE_URL=http://localhost:3000
# Contraseña del panel /admin (usuario: admin)
ADMIN_PASSWORD=cambiar-esta-clave
# Mercado Pago: Tus integraciones > Credenciales de producción > Access Token
# Si queda vacío, el sistema funciona en "modo demo" (reserva queda pendiente de pago manual).
MP_ACCESS_TOKEN=
# Claude API (asistente IA). Sin clave, el chat responde con un mensaje de derivación a WhatsApp.
ANTHROPIC_API_KEY=
# Minutos entre sincronizaciones iCal con Airbnb/Booking
ICAL_SYNC_MINUTES=15
# Carpeta de datos (en producción: volumen persistente)
DATA_DIR=data
